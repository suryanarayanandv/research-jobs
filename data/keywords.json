{
  "$comment": "searchTerms go to each ATS search box. A job is kept only if its TITLE matches a role (checked in order) and no exclude pattern. Its field score comes from fields matched in title (x2) + description/department text when the ATS provides it. score >= coreScore => strong match ('core'); otherwise 'related'. A job whose text matches an offField pattern and scores 0 on fields is dropped (e.g. 'Research Assistant - Economics').",
  "searchTerms": [
    "research",
    "laboratory",
    "scientist",
    "PhD"
  ],
  "coreScore": 4,
  "roles": [
    {
      "id": "project",
      "re": "\\bJRF\\b|\\bSRF\\b|junior research fellow|senior research fellow|project (assistant|associate|fellow|scientist|technician|technical|staff)|research fellow.{0,20}(project|DST|DBT|ICMR|CSIR|SERB)"
    },
    {
      "id": "phd",
      "re": "\\bph\\.?\\s?d\\b|\\bdphil\\b|doctoral (candidate|researcher|student|position|fellow)|\\bpre-?doc|predoctoral|post-?bac|postbaccalaureate|graduate (student|program|programme|research)|studentship|early stage researcher|\\bESR\\b|doktorand"
    },
    {
      "id": "industry",
      "re": "associate scientist|scientist\\s*(i|1|ii|2)\\b|\\b(research|lab|laboratory|cell biology|molecular biology|assay|in vivo|bioanalytical|biology|pharmacology|qc|r&d) analyst|research associate|\\bscientist\\b|biologist|in vivo|pharmacolog"
    },
    {
      "id": "tech",
      "re": "research (technician|technologist|assistant|aide|specialist|support|tech\\b|coordinator)|lab(oratory)? (technician|technologist|assistant|manager|aide|associate|specialist|operations)|technical (officer|assistant|specialist)|staff research associate|research associate|histotechnolog|animal (technician|technologist|care)|\\btechnician\\b|\\blab tech\\b"
    }
  ],
  "fields": [
    {
      "re": "neuro(?!log|surg)\\w*|brain|synap\\w*|neural|neuron\\w*|cogniti\\w*|psychiatr\\w*|behavio(u)?r\\w*|circadian|chronobiolog\\w*|sleep|epilep\\w*|electrophysiolog\\w*|optogenetic\\w*|psychedelic|addiction|pain",
      "w": 3
    },
    {
      "re": "molecular|cell biology|cellular|genetic\\w*|genomic\\w*|drosophila|zebrafish|\\bmice\\b|\\bmouse\\b|rodent|\\brat\\b|in vivo|stem cell|organoid|immunohistochem\\w*|histolog\\w*|\\bIHC\\b|western blot|\\bPCR\\b|confocal|microscop\\w*|cell culture|tissue culture|stereotax\\w*|viral vector|\\bAAV\\b",
